# Copy to .env.local for local development, and add the same six values
# as Environment Variables in your Vercel project settings.
# Values come from Firebase console → Project settings → Your apps → Web app → SDK config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only this Google account may sign in (comma-separate for several).
VITE_ALLOWED_EMAILS=

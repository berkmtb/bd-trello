rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own data, and only the
    // owner's verified Google account is allowed at all. (To change the owner,
    // edit the email below and publish these rules in the Firebase console.)
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'byamamoto@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
